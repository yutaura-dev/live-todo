# キーと説明だけを置き、実値は書かない。cp .env.example .env して値を入れる。
# 全行をコメントアウトしておく理由: そのまま cp しても秘匿キーが .env に有効な形で
# 入らず、非秘匿（.env）と秘匿（.env.local）の分離が初回セットアップで壊れない。

# ── .env に書く（非秘匿の環境差分）──
# LIVE_TODO_CONFIG=./config.json   # 設定ファイルの場所（形式は config.example.json）
# AWS_PROFILE=                     # Bedrock を使う場合のプロファイル名

# ── .env.local に書く（秘匿値。.env には置かない）──
# 秘密情報は LIVE_TODO_SECRET_<キー> で渡す。キーの "." や "-" は "_" に、英字は大文字にする。
# LIVE_TODO_SECRET_GITHUB_WORK_TOKEN=       # accounts[].id が "work" の GitHub アカウントのトークン
# LIVE_TODO_SECRET_GITHUB_PERSONAL_TOKEN=
# LIVE_TODO_SECRET_LLM_ANTHROPIC_API_KEY=
# LIVE_TODO_SECRET_LLM_OPENAI_API_KEY=
# LIVE_TODO_SECRET_LLM_GEMINI_API_KEY=
# LIVE_TODO_SECRET_LLM_AZURE_OPENAI_API_KEY=
