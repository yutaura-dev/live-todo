{
  "llmProfiles": {
    "work": {
      "provider": "openai",
      "model": "gpt-5.2"
    },
    "personal": {
      "provider": "anthropic",
      "model": "claude-haiku-5-5"
    },
    "offline": {
      "provider": "none",
      "model": "-"
    }
  },
  "defaultLlmProfile": "work",
  "accounts": [
    {
      "kind": "github",
      "id": "work",
      "repositories": {
        "include": [
          "acme/*"
        ],
        "exclude": [
          "acme/legacy"
        ]
      }
    },
    {
      "kind": "github",
      "id": "personal",
      "llmProfile": "personal",
      "initialLookbackDays": 7
    }
  ]
}
