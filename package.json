{
  "name": "live-todo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@effect/vitest": "4.1.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "drizzle-kit": "1.0.0-rc.6",
    "electron": "45.4.1",
    "electron-vite": "6.0.0",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "8.3.8",
    "vitest": "^5.1.1"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "sync:once": "tsx src/app/main.ts once",
    "sync:watch": "tsx src/app/main.ts watch",
    "judge:export": "tsx src/app/judge-eval.ts export",
    "judge:eval": "tsx src/app/judge-eval.ts run",
    "app:dev": "electron-vite dev",
    "app:build": "electron-vite build",
    "app:start": "electron-vite preview"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@effect/ai-anthropic": "4.1.5",
    "@effect/ai-openai": "4.1.5",
    "@effect/platform-node": "4.1.5",
    "@effect/sql-sqlite-node": "4.1.5",
    "drizzle-orm": "1.0.0-rc.6",
    "effect": "4.1.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "main": "out/main/index.js"
}
